{
  "name": "bortdaily",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard personale: posta, meteo, promemoria, calendario, notizie e Telegram",
  "type": "module",
  "scripts": {
    "serve": "node scripts/dev.mjs",
    "release:patch": "node scripts/bump.mjs patch",
    "release:minor": "node scripts/bump.mjs minor",
    "release:major": "node scripts/bump.mjs major",
    "test": "node tests/unit.mjs && node tests/adapters.mjs && node tests/api.mjs && node tests/smoke.mjs",
    "vendor": "node scripts/vendor.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "playwright": "1.63.0"
  },
  "dependencies": {
    "@mtcute/web": "0.32.8"
  }
}
